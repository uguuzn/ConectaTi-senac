# Copie para .env.local (ignorado pelo Git) e preencha os valores locais.
# Gere APP_AUTH_TOKEN_SECRET no PowerShell com os comandos da seção Configuração local do README.
APP_AUTH_TOKEN_SECRET=
DB_URL=
DB_USERNAME=
DB_PASSWORD=
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
